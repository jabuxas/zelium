# ============================================================
# Zelium — Ambiente de produção (servidor próprio da equipe)
# Copie para .env e preencha com os valores reais:
#   cp deploy/.env.example deploy/.env
# ============================================================

# Domínio público via DuckDNS (ex.: zelium.duckdns.org)
ZELAR_DOMAIN=zelium.duckdns.org

# DuckDNS — token da conta (para atualização de IP dinâmico)
DUCKDNS_TOKEN=troque-me

# Banco de dados
POSTGRES_DB=zelar
POSTGRES_USER=zelar
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Segredos da aplicação
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
# Gere com: openssl rand -base64 48

# SMTP — servidor de e-mail (notificações automáticas)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=no-reply@exemplo.com
SMTP_PASSWORD=troque-me
SMTP_FROM="Zelium <no-reply@exemplo.com>"

# Retenção dos backups (dias)
BACKUP_RETENTION_DAYS=14
