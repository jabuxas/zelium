# ============================================================
# Zelium — Ambiente de produção (servidor próprio da equipe)
# Copie para .env e preencha com os valores reais:
#   cp deploy/.env.example deploy/.env
# ============================================================

# Domínio público (o Caddy emite o HTTPS sozinho). Pode ser domínio próprio
# (zelium.suaempresa.com.br, com DNS já apontando para o servidor) ou DuckDNS.
ZELAR_DOMAIN=zelium.duckdns.org

# DuckDNS (OPCIONAL) — só se o domínio for DuckDNS com IP dinâmico.
# Descomente as 3 linhas; DUCKDNS_SUBDOMAIN é só o nome (zelium.duckdns.org -> zelium).
# COMPOSE_PROFILES=duckdns
# DUCKDNS_TOKEN=seu-token
# DUCKDNS_SUBDOMAIN=zelium

# Banco de dados
POSTGRES_DB=zelar
POSTGRES_USER=zelar
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Segredos da aplicação
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
# Gere com: openssl rand -base64 48

# --- Primeira subida (servidor novo) ---------------------------------------
# Cria a sua organização e o Gestor na primeira vez que o backend sobe e
# desativa as contas demo (gestor@zelium.com... senha pública Zelium@2026).
# Senha: 12+ caracteres. Pode ficar aqui depois: é idempotente e NUNCA
# sobrescreve a senha de um e-mail que já existe (use "esqueci minha senha").
BOOTSTRAP_GESTOR_EMAIL=
BOOTSTRAP_GESTOR_SENHA=
# BOOTSTRAP_GESTOR_NOME=Gestor
# BOOTSTRAP_ORGANIZACAO_NOME=Minha organização
# Transição: sobe mesmo com as contas demo ativas (NÃO recomendado em produção).
# PERMITIR_CONTAS_DEMO=true

# --- Cadastro público e recuperação de senha (exigem SMTP abaixo) ------------
# As URLs de confirmação são derivadas de ZELAR_DOMAIN.
SELF_SERVICE_ENABLED=false
RECUPERACAO_SENHA_ENABLED=false
# JWT_EXPIRES_IN=7d
# RATE_LIMIT_LOGIN_MAX=10

# Origens web autorizadas ao CORS com credenciais (separadas por vírgula).
# Produção same-origin pelo Caddy não precisa desta variável (padrão vazio).
# WEB_ORIGINS=https://app.exemplo.com,https://outro-domínio.exemplo.com

# SMTP — servidor de e-mail (notificações automáticas e links de acesso).
# Homologado em 04/11/2026 com Migadu: smtp.migadu.com, porta 465 (SSL),
# SMTP_USER = endereço completo na Migadu. Com 465 o backend usa TLS implícito.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=no-reply@exemplo.com
SMTP_PASSWORD=troque-me
SMTP_FROM="Zelium <no-reply@exemplo.com>"

# Retenção dos backups (dias)
BACKUP_RETENTION_DAYS=14

# Proxies confiáveis à frente do backend (Caddy = 1). Use 0 se o backend
# ficar acessível sem proxy; X-Forwarded-For forjado burlaria limites por IP.
TRUST_PROXY=1
